<Page
    x:Class="DiskTree.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DiskTree.App"
    xmlns:controls="using:DiskTree.App.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Action Bar -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,8,16,8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <!-- Drive / Folder Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <DropDownButton x:Name="DriveDropdown" Content="Select Drive">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="DriveMenuFlyout" />
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button x:Name="BrowseButton" Click="OnBrowseFolderClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xED25;" FontSize="14" />
                            <TextBlock Text="Open Folder" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RescanButton" Click="OnRescanClicked" ToolTipService.ToolTip="Rescan current folder">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Breadcrumbs -->
                <BreadcrumbBar Grid.Column="1"
                               x:Name="PathBreadcrumbBar"
                               VerticalAlignment="Center"
                               ItemClicked="OnBreadcrumbItemClicked" />

                <!-- Metric Toggle (Bytes vs Files) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <RadioButtons SelectedIndex="0" MaxColumns="2" SelectionChanged="OnMetricChanged">
                        <RadioButton Content="Size" Tag="Bytes" />
                        <RadioButton Content="Files" Tag="Files" />
                    </RadioButtons>
                </StackPanel>

                <!-- Search / Filter Box -->
                <AutoSuggestBox Grid.Column="3"
                                x:Name="SearchBox"
                                PlaceholderText="Filter by name..."
                                QueryIcon="Find"
                                TextChanged="OnSearchTextChanged" />
            </Grid>
        </Border>

        <!-- Main Body: Treemap on Left, Inspector Side Panel on Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" MaxWidth="500" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Treemap Mosaic Canvas with Top-Edge Scan Progress Bar -->
            <Grid Grid.Column="0">
                <controls:TreemapCanvasView x:Name="TreemapCanvas" />
                <ProgressBar x:Name="ScanProgressBar"
                             VerticalAlignment="Top"
                             Height="3"
                             CornerRadius="0"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Opacity="0"
                             IsHitTestVisible="False"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            </Grid>

            <!-- Splitter border -->
            <Border Grid.Column="1" Width="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <!-- Side Inspector Panel -->
            <ScrollViewer Grid.Column="2"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          Padding="16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">

                    <!-- Selected Item Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="SELECTION"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <TextBlock x:Name="SelectedNameText"
                                       Text="No selection"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="2" />

                            <TextBlock x:Name="SelectedPathText"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" />

                            <Grid ColumnSpacing="8" RowSpacing="6" Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Size" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SelectedSizeText" Text="-" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="Items" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SelectedFilesText" Text="-" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,0,0">
                                    <TextBlock Text="Category" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SelectedCategoryText" Text="-" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,4,0,0">
                                    <TextBlock Text="Reclaimable" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SelectedReclaimText" Text="No" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <!-- Selection Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Button x:Name="ToggleMarkButton"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Click="OnToggleMarkClicked"
                                        IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="MarkButtonIcon" Glyph="&#xE74D;" FontSize="13" />
                                        <TextBlock x:Name="MarkButtonText" Text="Mark for Removal" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="DrillInButton"
                                        Click="OnDrillInClicked"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Drill into folder">
                                    <FontIcon Glyph="&#xE76C;" FontSize="13" />
                                </Button>

                                <Button x:Name="OpenExplorerButton"
                                        Click="OnOpenInExplorerClicked"
                                        IsEnabled="False"
                                        ToolTipService.ToolTip="Reveal in File Explorer">
                                    <FontIcon Glyph="&#xEC50;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- "Worth a Look" Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="WORTH A LOOK"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBlock Text="Largest reclaimable caches, temporary files, and build artifacts."
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" />

                            <ListView x:Name="WorthALookList"
                                      SelectionMode="Single"
                                      SelectionChanged="OnWorthALookSelectionChanged"
                                      MaxHeight="260">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Finding.Description}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding PathText}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Text="{Binding BytesText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Mark"
                                                    FontSize="11"
                                                    Click="OnMarkCandidateClicked"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0"
                                                    Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <!-- Volume Space & Deletion Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="VOLUME SPACE"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <ProgressBar x:Name="VolumeProgressBar" Height="8" CornerRadius="4" Value="0" Maximum="100" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Free Now" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="FreeSpaceNowText" Text="-" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="After Removal" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="FreeSpaceProjectedText" Text="-" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Review & Removal Action -->
                            <Button x:Name="ReviewRemovalButton"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,6,0,0"
                                    Click="OnReviewRemovalClicked"
                                    IsEnabled="False">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock x:Name="ReviewButtonText" Text="Review Marks (0)" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar & Legend Footer -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6,16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="ScanProgressRing" IsActive="False" Width="14" Height="14" />
                    <TextBlock x:Name="StatusMessageText"
                               Text="Ready"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Swatch Legend -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Rectangle Width="9" Height="9" Fill="#5177B8" RadiusX="2" RadiusY="2" />
                        <TextBlock Text="Code" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Rectangle Width="9" Height="9" Fill="#B87951" RadiusX="2" RadiusY="2" />
                        <TextBlock Text="Scratch" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Rectangle Width="9" Height="9" Fill="#51B883" RadiusX="2" RadiusY="2" />
                        <TextBlock Text="Toolchain" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Rectangle Width="9" Height="9" Fill="#B8516C" RadiusX="2" RadiusY="2" />
                        <TextBlock Text="Git" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Rectangle Width="9" Height="9" Fill="#8151B8" RadiusX="2" RadiusY="2" />
                        <TextBlock Text="Media" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Rectangle Width="9" Height="9" Fill="#7B828D" RadiusX="2" RadiusY="2" />
                        <TextBlock Text="Docs" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Rectangle Width="9" Height="9" Fill="#B59D53" RadiusX="2" RadiusY="2" />
                        <TextBlock Text="Cache" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Rectangle Width="9" Height="9" Fill="#F59E0B" RadiusX="2" RadiusY="2" />
                        <TextBlock Text="Reclaimable" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Removal Review Dialog -->
        <ContentDialog x:Name="RemovalDialog"
                       Title="Review Marked Removals"
                       PrimaryButtonText="Delete"
                       CloseButtonText="Cancel"
                       DefaultButton="Close">
            <StackPanel Spacing="14" MaxWidth="500">
                <TextBlock x:Name="RemovalSummaryText"
                           Text="Reviewing items marked for removal..."
                           TextWrapping="Wrap" />

                <RadioButtons x:Name="RemovalModeRadios" Header="Removal Method:">
                    <RadioButton Content="Move to Recycle Bin (Recommended - Safe and recoverable)" IsChecked="True" />
                    <RadioButton Content="Permanently Delete (Shift+Delete - Unrecoverable)" />
                </RadioButtons>

                <TextBlock Text="Targets to be removed:" FontWeight="SemiBold" FontSize="12" />
                <ListView x:Name="RemovalTargetsList" MaxHeight="160" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path}" FontSize="11" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="RemovalCoveredText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="RemovalBlockedText" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
